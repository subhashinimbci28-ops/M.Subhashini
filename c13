#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() 
{

int n;
    scanf("%d", &n);
    
    // Total size of the grid row and column wise
    int size = 2 * n - 1;
    
    // Loop through each row
    for (int i = 0; i < size; i++) {
        // Loop through each column
        for (int j = 0; j < size; j++) {
            // Find the minimum distance from the current cell to any of the four borders
            int min = i < j ? i : j;
            min = min < size - i - 1 ? min : size - i - 1;
            min = min < size - j - 1 ? min : size - j - 1;
            
            // The value at the cell is n minus the minimum distance
            printf("%d ", n - min);
        }
        printf("\n");
    }
    
