#include <stdio.h>
#include <stdlib.h>

// Comparison function for qsort to sort candidates in ascending order
int compare(const void* a, const void* b) {
    return (*(int*)a - *(int*)b);
}

// Backtracking helper function
void backtrack(int* candidates, int candidatesSize, int target, int start, 
               int* current, int currentSize, 
               int*** results, int* returnSize, int** returnColumnSizes, int* capacity) {
    
    // Base case: combination found
    if (target == 0) {
        // Double capacity if results array is full
        if (*returnSize >= *capacity) {
            *capacity *= 2;
            *results = realloc(*results, sizeof(int*) * (*capacity));
            *returnColumnSizes = realloc(*returnColumnSizes, sizeof(int) * (*capacity));
        }
        
        // Copy current combination to results
        (*results)[*returnSize] = (int*)malloc(sizeof(int) * currentSize);
        for (int i = 0; i < currentSize; i++) {
            (*results)[*returnSize][i] = current[i];
        }
        (*returnColumnSizes)[*returnSize] = currentSize;
        (*returnSize)++;
        return;
    }

    for (int i = start; i < candidatesSize; i++) {
        // Optimization: Large candidate means subsequent ones are also too large
        if (candidates[i] > target) {
            break;
        }
        
        // Skip duplicate combinations at the same decision level
        if (i > start && candidates[i] == candidates[i - 1]) {
            continue;
        }

        // Include candidates[i] into the current path
        current[currentSize] = candidates[i];
        
        // Move to the next element (i + 1 ensures each number is used once)
        backtrack(candidates, candidatesSize, target - candidates[i], i + 1, 
                  current, currentSize + 1, 
                  results, returnSize, returnColumnSizes, capacity);
    }
}

/**
 * Return an array of arrays of size *returnSize.
 * The sizes of the arrays are returned as *returnColumnSizes array.
 * Note: Both returned arrays and *returnColumnSizes array must be malloced, assume caller calls free().
 */
int** combinationSum2(int* candidates, int candidatesSize, int target, int* returnSize, int** returnColumnSizes) {
    // 1. Sort the array to handle duplicates and allow early termination
    qsort(candidates, candidatesSize, sizeof(int), compare);

    // 2. Initialize memory for result tracking
    int capacity = 100;
    int** results = (int**)malloc(sizeof(int*) * capacity);
    *returnColumnSizes = (int*)malloc(sizeof(int) * capacity);
    *returnSize = 0;

    // Temporary storage array for the current path
    int* current = (int*)malloc(sizeof(int) * candidatesSize);

    // 3. Begin backtracking
    backtrack(candidates, candidatesSize, target, 0, current, 0, &results, returnSize, returnColumnSizes, &capacity);

    // Clean up temporary tracking array
    free(current);

    return results;
}
