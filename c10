#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {

    char *s;
    s = malloc(1024 * sizeof(char));
    scanf("%[^\n]", s);
    s = realloc(s, strlen(s) + 1);
    
    // Write your logic to print the tokens of the sentence here.
    // Initialize the token pointer with the first word, splitting by space
    char *token = strtok(s, " ");
    
    // Loop through the string to extract and print all remaining tokens
    while (token != NULL) {
        printf("%s\n", token);
        token = strtok(NULL, " "); // Pass NULL to continue splitting the same string
    }

    // Free the dynamically allocated memory before exiting
    free(s);
    
    return 0;
}
