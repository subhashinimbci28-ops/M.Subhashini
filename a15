#include <string.h>
#include <stdlib.h>

bool isValid(char * s) {
    int len = strlen(s);
    if (len % 2 != 0) return false; // Odd length cannot be valid

    char *stack = (char *)malloc(len * sizeof(char));
    int top = -1;

    for (int i = 0; i < len; i++) {
        char c = s[i];
        if (c == '(' || c == '{' || c == '[') {
            stack[++top] = c; // Push opening bracket
        } else {
            if (top == -1) {
                free(stack);
                return false; // No matching opening bracket
            }
            char popped = stack[top--];
            if ((c == ')' && popped != '(') ||
                (c == '}' && popped != '{') ||
                (c == ']' && popped != '[')) {
                free(stack);
                return false; // Mismatched type
            }
        }
    }

    bool valid = (top == -1); // True if stack is empty
    free(stack);
    return valid;
}
